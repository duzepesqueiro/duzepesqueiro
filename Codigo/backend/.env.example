# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Supabase (Prisma)
DATABASE_URL="postgresql://<user>.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://<user>.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"


# Connect to Supabase via connection pooling
DATABASE_URL_BUCKET=
# Direct connection to the database. Used for migrations
DIRECT_URL_BUCKET=
# MongoDB (Atlas)
MONGODB_URL="mongodb+srv://<user>:<password>@<cluster>/<db>?appName=<app>"

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Email (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM="Company <noreply@email.com>"
HOSTING_CHECKIN_TIME=14:00
HOSTING_CHECKOUT_TIME=12:00
HOSTING_CONTACT_PHONE=+55 (31) 99999-0000
HOSTING_CONTACT_WHATSAPP=+55 (31) 99999-0000
HOSTING_CONTACT_EMAIL=contato@duzepesqueiro.com

# Payment - Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key
MERCADOPAGO_CLIENT_ID=your_mercadopago_client_id
MERCADOPAGO_CLIENT_SECRET=your_mercadopago_client_secret
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret
MERCADOPAGO_WEBHOOK_URL=https://api.your-domain.com/payments/webhook/mercadopago
MERCADOPAGO_CHECKOUT_SUCCESS_URL=https://app.your-domain.com/pagamento/sucesso
MERCADOPAGO_CHECKOUT_PENDING_URL=https://app.your-domain.com/pagamento/pendente
MERCADOPAGO_CHECKOUT_FAILURE_URL=https://app.your-domain.com/pagamento/falha
PAYMENT_MIN_INSTALLMENT_VALUE=
PAYMENT_MIN_VALUE_FOR_INSTALLMENTS=

# Frontend URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
