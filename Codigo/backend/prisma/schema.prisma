generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
  CUSTOMER
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum PaymentDomain {
  SALES
  RENTAL
  HOSTING
  EVENT
}

enum PaymentStatus {
  PENDING
  PAID
  APPROVED
  AUTHORIZED
  IN_PROCESS
  IN_MEDIATION
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
  FAILED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
}

enum RentalStatus {
  PENDING
  ACTIVE
  RETURNED
  CANCELLED
  OVERDUE
}

enum RentalOrigin {
  ONLINE
  WALK_IN
}

enum ItemCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum RentalPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum EventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  UPCOMING
}

enum EventRegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  PAID
}

enum EventPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum KpiType {
  ACTIVE_EVENTS
  REGISTERED_PARTICIPANTS
  REGISTRATION_PERCENTAGE
  SOLD_OUT_EVENTS
}

enum ProductStatus {
  RENTAL
  SALE
  RESTAURANT
  HOSTING
  EVENT
}

enum ProductCategory {
  FISHING_EQUIPMENT
  FOOD
  RENTAL_EQUIPMENT
  EVENT_ITEM
  HOSTING_ITEM
  DRINK
  ACCESSORY
  CLEANING_MATERIAL
  OTHER
}

enum UnitMeasure {
  KG
  UNIT
  LITER
  PACKAGE
  METER
  BOX
}

enum TurnoverRate {
  HIGH
  MEDIUM
  LOW
}

enum InventoryMovementType {
  INBOUND
  OUTBOUND
}

enum InventoryMovementReason {
  SALE
  PURCHASE
  DAMAGE
  LOSS
  RETURN
  ADJUSTMENT
  RENTAL
  RENTAL_RETURN
  TRANSFER
}

enum RentalEquipmentQuality {
  GOOD
  MEDIUM
  BAD
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

enum DeliveryStatus {
  COMPLETE
  PARTIAL
  LATE
}

enum OrderPriority {
  HIGH
  MEDIUM
  LOW
}

enum StockKpiType {
  TOTAL_STOCK_VALUE
  STOCK_TURNOVER
  STOCKOUT_FREQUENCY
  LOW_STOCK
  AGED_STOCK
}

enum ChaleType {
  STANDARD
  DELUXE
  SUITE
}

enum ChaleStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  CLEANING
  ADMIN
  INTERDICTED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  OCCUPIED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum HostingReservationOrigin {
  ONLINE
  WALK_IN
  ADMIN
}

enum PriceRuleType {
  SEASON
  WEEKEND
  HOLIDAY
  DISCOUNT
}

enum BlockReason {
  MAINTENANCE
  CLEANING
  ADMIN
  INTERDICTION
}

enum ReservationPaymentType {
  RESERVATION
  CANCELLATION_FEE
  ADDITIONAL_FEE
  REFUND
}

enum HostingContactChannel {
  EMAIL
  PHONE
  WHATSAPP
}

enum HospedagemKpiType {
  OCCUPANCY_RATE
  TOTAL_REVENUE
  ACTIVE_RESERVATIONS
  CANCELLED_RESERVATIONS
  AVAILABLE_CHALES
  OCCUPIED_CHALES
}

enum HostingNotificationChannel {
  EMAIL
  WHATSAPP
  PAYMENT
}

enum HostingNotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

model User {
  id                 String                        @id @default(uuid())
  username           String                        @unique
  passwordHash       String
  role               UserRole                      @default(CUSTOMER)
  isActive           Boolean                       @default(true)
  status             UserStatus                    @default(ACTIVE)
  failedAttempts     Int                           @default(0)
  lastLoginAt        DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  profile            UserProfile?
  emails             UserEmail[]
  phones             UserPhone[]
  payments           Payment[]
  eventRegistrations EventRegistration[]
  createdProducts    Product[]                     @relation("ProductCreatedBy")
  editedProducts     Product[]                     @relation("ProductEditedBy")
  inventoryMovements InventoryMovement[]           @relation("InventoryMovementUser")
  inventoryLocks     InventoryConcurrencyControl[] @relation("InventoryLockUser")
  rentals            Rental[]
  rentalCarts        RentalCart[]
  rentalAuditLogs    RentalAuditLog[]              @relation("RentalAuditLogUser")
  hostingReservations       HostingReservation[] @relation("HostingReservationUser")
  hostingCreatedReservations HostingReservation[] @relation("HostingReservationCreatedBy")
  hostingUpdatedReservations HostingReservation[] @relation("HostingReservationUpdatedBy")
  hostingChaletBlocks       HostingChaletBlock[] @relation("HostingChaletBlockCreatedBy")
  hostingCreatedPricingRules HostingPricingRule[] @relation("HostingPricingRuleCreatedBy")
  hostingUpdatedPricingRules HostingPricingRule[] @relation("HostingPricingRuleUpdatedBy")
  hostingAuditLogs          HostingAuditLog[] @relation("HostingAuditLogUser")
  hostingReservationReviews HostingReservationReview[] @relation("HostingReservationReviewUser")
  hostingNotificationLogs   HostingNotificationLog[] @relation("HostingNotificationLogUser")
  hostingCreatedCancellationPolicies HostingCancellationPolicy[] @relation("HostingCancellationPolicyCreatedBy")

  @@map("users")
}

model Payment {
  id                String              @id @default(uuid())
  externalId        Int?                @unique @map("external_id")
  domain            PaymentDomain
  entityId          String              @map("entity_id")
  externalReference String              @unique @map("external_reference")
  transactionAmount Decimal             @map("transaction_amount") @db.Decimal(10, 2)
  netReceivedAmount Decimal?            @map("net_received_amount") @db.Decimal(10, 2)
  installments      Int                 @default(1)
  installmentAmount Decimal?            @map("installment_amount") @db.Decimal(10, 2)
  status            PaymentStatus       @default(PENDING)
  statusDetail      String?             @map("status_detail")
  paymentMethod     PaymentMethod       @map("payment_method")
  paymentMethodId   String?             @map("payment_method_id")
  paymentTypeId     String?             @map("payment_type_id")
  issuerId          String?             @map("issuer_id")
  payerEmail        String              @map("payer_email")
  payerName         String?             @map("payer_name")
  payerDocument     String?             @map("payer_document")
  payerDocumentType String?             @map("payer_document_type")
  pixQrCode         String?             @map("pix_qr_code") @db.Text
  pixQrCodeBase64   String?             @map("pix_qr_code_base64") @db.Text
  pixTicketUrl      String?             @map("pix_ticket_url")
  idempotencyKey    String              @unique @map("idempotency_key")
  captured          Boolean             @default(false)
  binaryMode        Boolean             @default(false) @map("binary_mode")
  metadata          Json?
  dateCreated       DateTime            @default(now()) @map("date_created")
  dateApproved      DateTime?           @map("date_approved")
  dateLastUpdated   DateTime            @updatedAt @map("date_last_updated")
  dateOfExpiration  DateTime?           @map("date_of_expiration")
  moneyReleaseDate  DateTime?           @map("money_release_date")
  userId            String              @map("user_id")
  user              User                @relation(fields: [userId], references: [id])
  webhookLogs       PaymentWebhookLog[]
  refunds           PaymentRefund[]
  hostingReservations HostingReservation[]

  @@index([domain, entityId])
  @@index([status])
  @@index([externalReference])
  @@index([payerEmail])
  @@index([dateCreated])
  @@map("payments")
}

model Event {
  id             String              @id @default(uuid())
  title          String
  description    String
  rules          String
  location       String
  imageUrl       String              @map("image_url")
  imageKey       String              @map("image_key")
  totalSlots     Int                 @map("total_slots")
  availableSlots Int                 @map("available_slots")
  eventDate      DateTime            @map("event_date")
  eventTime      String              @map("event_time")
  status         EventStatus         @default(SCHEDULED)
  price          Decimal?            @db.Decimal(10, 2)
  isPaid         Boolean             @default(false) @map("is_paid")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  registrations  EventRegistration[]
  eventImages    EventImage[]

  @@index([eventDate])
  @@index([status])
  @@map("events")
}

model EventImage {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  imageUrl  String   @map("image_url")
  imageKey  String   @map("image_key")
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_images")
}

model EventRegistration {
  id            String                  @id @default(uuid())
  userId        String                  @map("user_id")
  eventId       String                  @map("event_id")
  status        EventRegistrationStatus @default(PENDING)
  orderId       String?                 @map("order_id")
  paymentStatus EventPaymentStatus?     @map("payment_status")
  registeredAt  DateTime                @default(now()) @map("registered_at")
  confirmedAt   DateTime?               @map("confirmed_at")
  cancelledAt   DateTime?               @map("cancelled_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("event_registrations")
}

model EventKpiGoal {
  id          String   @id @default(uuid())
  kpiType     KpiType  @map("kpi_type")
  targetValue Decimal  @map("target_value") @db.Decimal(10, 2)
  month       Int
  year        Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([kpiType, month, year])
  @@index([kpiType, month, year])
  @@map("event_kpi_goals")
}

model PaymentWebhookLog {
  id          String   @id @default(uuid())
  paymentId   String   @map("payment_id")
  payment     Payment  @relation(fields: [paymentId], references: [id])
  requestId   String   @unique @map("request_id")
  action      String
  type        String
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("payment_webhook_logs")
}

model PaymentRefund {
  id         String   @id @default(uuid())
  paymentId  String   @map("payment_id")
  payment    Payment  @relation(fields: [paymentId], references: [id])
  externalId Int?     @map("external_id")
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?
  status     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("payment_refunds")
}

model UserProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  fullName  String
  document  String?
  birthDate DateTime?
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserEmail {
  id         String  @id @default(uuid())
  userId     String
  email      String  @unique
  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)
  token      String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_emails")
}

model UserPhone {
  id               String    @id @default(uuid())
  userId           String
  phoneNumber      String
  isPrimary        Boolean   @default(false)
  isVerified       Boolean   @default(false)
  verificationCode String?
  verifiedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_phones")
}

model Supplier {
  id                  String          @id @default(uuid())
  name                String          @map("nome") @db.VarChar(255)
  cnpj                String          @unique @db.VarChar(18)
  rating              Int             @map("classificacao") @db.SmallInt
  totalOrders         Int             @default(0) @map("total_pedidos")
  accumulatedValue    Decimal         @default(0) @map("valor_acumulado") @db.Decimal(15, 2)
  totalItemsPurchased Int             @default(0) @map("total_itens_comprados")
  onTimeDeliveries    Int             @default(0) @map("entregas_no_prazo")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")
  products            Product[]
  purchaseOrders      PurchaseOrder[]

  @@map("fornecedores")
}

model Product {
  id                 String                       @id @default(uuid())
  sku                String                       @unique
  name               String                       @map("nome") @db.VarChar(255)
  description        String?                      @map("descricao") @db.Text
  image              String?                      @map("imagem") @db.VarChar(500)
  status             ProductStatus                @map("status")
  category           ProductCategory              @map("categoria")
  unitMeasure        UnitMeasure                  @map("unidade_medida")
  stockQuantity      Decimal                      @default(0) @map("quantidade_estoque") @db.Decimal(15, 3)
  minimumLimit       Decimal                      @default(0) @map("limite_minimo") @db.Decimal(15, 3)
  suggestedQuantity  Decimal                      @default(0) @map("quantidade_sugerida") @db.Decimal(15, 3)
  costPrice          Decimal                      @default(0) @map("preco_custo") @db.Decimal(15, 2)
  salePrice          Decimal                      @default(0) @map("preco_venda") @db.Decimal(15, 2)
  location           String?                      @map("localizacao") @db.VarChar(255)
  restockDate        DateTime?                    @map("data_reabastecimento")
  supplierId         String                       @map("fornecedor_id")
  createdById        String                       @map("criado_por")
  editedById         String?                      @map("editado_por")
  turnoverRate       TurnoverRate                 @default(MEDIUM) @map("rotatividade")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  deletedAt          DateTime?                    @map("deleted_at")
  supplier           Supplier                     @relation(fields: [supplierId], references: [id])
  createdBy          User                         @relation("ProductCreatedBy", fields: [createdById], references: [id])
  editedBy           User?                        @relation("ProductEditedBy", fields: [editedById], references: [id])
  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  concurrencyControl InventoryConcurrencyControl?
  rentalInventory    RentalInventory?             @relation("ProductToRentalInventory")
  rentalItems        RentalItem[]                 @relation("ProductToRentalItem")
  rentalCartItems    RentalCartItem[]             @relation("ProductToRentalCartItem")
  productImages      ProductImage[]

  @@index([status, deletedAt])
  @@index([category, deletedAt])
  @@index([supplierId])
  @@map("produtos")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("produto_id")
  imageUrl  String   @map("image_url") @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("produto_imagens")
}

model InventoryMovement {
  id              String                  @id @default(uuid())
  productId       String                  @map("produto_id")
  movementType    InventoryMovementType   @map("tipo")
  movementReason  InventoryMovementReason @map("motivo")
  quantity        Decimal                 @db.Decimal(15, 3)
  previousBalance Decimal                 @map("saldo_anterior") @db.Decimal(15, 3)
  nextBalance     Decimal                 @map("saldo_posterior") @db.Decimal(15, 3)
  referenceId     String?                 @map("referencia_id")
  referenceType   String?                 @map("referencia_tipo")
  userId          String                  @map("usuario_id")
  note            String?                 @map("observacao") @db.Text
  createdAt       DateTime                @default(now()) @map("created_at")
  product         Product                 @relation(fields: [productId], references: [id])
  user            User                    @relation("InventoryMovementUser", fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([movementType, createdAt])
  @@map("movimentacao_estoque")
}

model RentalInventory {
  productId        String                 @id @map("produto_id")
  quality          RentalEquipmentQuality @map("qualidade")
  lastVerification DateTime               @map("ultima_verificacao")
  note             String?                @map("observacao") @db.Text
  product          Product                @relation("ProductToRentalInventory", fields: [productId], references: [id])

  @@map("inventario_aluguel")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  supplierId       String              @map("fornecedor_id")
  status           PurchaseOrderStatus @map("status")
  deliveryStatus   DeliveryStatus      @map("status_entrega")
  priority         OrderPriority       @map("prioridade")
  orderDate        DateTime            @map("data_pedido")
  expectedDelivery DateTime            @map("data_entrega_prevista")
  deliveredAt      DateTime?           @map("data_entrega_real")
  totalAmount      Decimal             @default(0) @map("valor_total") @db.Decimal(15, 2)
  note             String?             @map("observacao") @db.Text
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  items            PurchaseOrderItem[]

  @@index([supplierId, status])
  @@index([orderDate])
  @@map("ordens_compra")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("ordem_compra_id")
  productId        String        @map("produto_id")
  quantity         Decimal       @db.Decimal(15, 3)
  unitPrice        Decimal       @map("preco_unitario") @db.Decimal(15, 2)
  receivedQuantity Decimal       @default(0) @map("quantidade_recebida") @db.Decimal(15, 3)
  createdAt        DateTime      @default(now()) @map("created_at")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product          Product       @relation(fields: [productId], references: [id])

  @@map("itens_ordem_compra")
}

model StockKpiAggregate {
  id                  String       @id @default(uuid())
  referenceDate       DateTime     @map("data_referencia") @db.Date
  kpiType             StockKpiType @map("tipo_kpi")
  value               Decimal      @map("valor") @db.Decimal(15, 2)
  percentageVariation Decimal?     @map("variacao_percentual") @db.Decimal(5, 2)
  metadata            Json?
  createdAt           DateTime     @default(now()) @map("created_at")

  @@unique([kpiType, referenceDate])
  @@index([kpiType, referenceDate])
  @@map("kpi_agregados")
}

model InventoryConcurrencyControl {
  id             String    @id @default(uuid())
  productId      String    @unique @map("produto_id")
  version        Int       @default(0) @map("versao")
  lockExpiration DateTime? @map("lock_expiracao")
  lockedById     String?   @map("locked_by")
  product        Product   @relation(fields: [productId], references: [id])
  lockedBy       User?     @relation("InventoryLockUser", fields: [lockedById], references: [id])

  @@map("controle_concorrencia")
}

model Rental {
  id            String           @id @default(uuid())
  userId        String
  origin        RentalOrigin
  paymentStatus PaymentStatus    @default(PENDING)
  totalAmount   Decimal          @db.Decimal(12, 2)
  rentalDate    DateTime         @db.Date
  returnDate    DateTime         @db.Date
  periodType    RentalPeriod     @default(DAILY)
  periodValue   Int              @default(1)
  notes         String?
  paymentMethod String?
  paymentId     String?
  paidAt        DateTime?
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         RentalItem[]
  auditLogs     RentalAuditLog[]

  @@index([userId, rentalDate])
  @@index([paymentStatus])
  @@index([origin])
  @@index([rentalDate])
  @@index([deletedAt])
  @@index([paymentStatus, rentalDate])
  @@index([userId, deletedAt])
  @@map("rentals")
}

model RentalItem {
  id              String         @id @default(uuid())
  rentalId        String
  productId       String
  quantity        Int
  unitPrice       Decimal        @db.Decimal(12, 2)
  subtotal        Decimal        @db.Decimal(12, 2)
  checkOutAt      DateTime?
  checkInAt       DateTime?
  status          RentalStatus   @default(PENDING)
  returnCondition ItemCondition?
  conditionNotes  String?
  plannedDuration Int?
  actualDuration  Int?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  rental          Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  product         Product        @relation("ProductToRentalItem", fields: [productId], references: [id])

  @@index([rentalId])
  @@index([productId])
  @@index([status])
  @@index([checkOutAt])
  @@index([rentalId, status])
  @@index([deletedAt])
  @@index([status, checkOutAt])
  @@map("rental_items")
}

model RentalCart {
  id            String           @id @default(uuid())
  userId        String
  scheduledDate DateTime         @db.Date
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         RentalCartItem[]

  @@unique([userId])
  @@index([userId])
  @@map("rental_carts")
}

model RentalCartItem {
  id        String     @id @default(uuid())
  cartId    String
  productId String
  quantity  Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cart      RentalCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product    @relation("ProductToRentalCartItem", fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("rental_cart_items")
}

model PesqueiroConfig {
  id               String   @id @default(uuid())
  openingTime      String   @default("06:00")
  closingTime      String   @default("18:00")
  rentalDuration   Int      @default(480)
  maxRentalsPerDay Int      @default(100)
  overtimeRate     Decimal  @default(0) @db.Decimal(12, 2)
  active           Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("pesqueiro_config")
}

model RentalAuditLog {
  id        String   @id @default(uuid())
  rentalId  String
  userId    String?
  action    String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  rental    Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  user      User?    @relation("RentalAuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([rentalId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("rental_audit_logs")
}

model HostingChalet {
  id             String                  @id @default(uuid())
  code           String                  @unique @map("codigo") @db.VarChar(50)
  name           String                  @map("nome") @db.VarChar(255)
  description    String?                 @map("descricao") @db.Text
  amenities      String[]                @default([]) @map("comodidades")
  rooms          String[]                @default([]) @map("comodos")
  notes          String?                 @map("observacoes") @db.Text
  unitType       ChaleType               @map("tipo_unidade")
  status         ChaleStatus             @default(AVAILABLE) @map("status")
  basePrice      Decimal                 @map("preco_base") @db.Decimal(12, 2)
  maxGuests      Int                     @default(2) @map("max_hospedes")
  isActive       Boolean                 @default(true) @map("ativo")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  deletedAt      DateTime?               @map("deleted_at")
  reservations   HostingReservation[]
  availability   HostingChaletAvailability[]
  dateBlocks     HostingChaletBlock[]
  pricingRules   HostingPricingRuleChalet[]
  chaletAmenities HostingChaletAmenity[]
  images         HostingChaletImage[]
  reviews        HostingReservationReview[]
  auditLogs      HostingAuditLog[]

  @@index([status, deletedAt])
  @@index([isActive, deletedAt])
  @@index([unitType])
  @@map("hosting_chalets")
}

model HostingAmenity {
  id          String                @id @default(uuid())
  name        String                @unique @map("nome") @db.VarChar(120)
  description String?               @map("descricao") @db.Text
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  chalets     HostingChaletAmenity[]

  @@map("hosting_amenities")
}

model HostingChaletAmenity {
  id        String        @id @default(uuid())
  chaletId  String        @map("chale_id")
  amenityId String        @map("comodidade_id")
  createdAt DateTime      @default(now()) @map("created_at")
  chalet    HostingChalet @relation(fields: [chaletId], references: [id], onDelete: Cascade)
  amenity   HostingAmenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([chaletId, amenityId])
  @@index([amenityId])
  @@map("hosting_chalet_amenities")
}

model HostingChaletImage {
  id            String        @id @default(uuid())
  chaletId      String        @map("chale_id")
  imageUrl      String        @map("image_url") @db.VarChar(1000)
  imageKey      String        @map("image_key") @db.VarChar(500)
  fileSizeBytes Int           @map("file_size_bytes")
  mimeType      String?       @map("mime_type") @db.VarChar(120)
  position      Int           @default(1) @map("position")
  createdAt     DateTime      @default(now()) @map("created_at")
  chalet        HostingChalet @relation(fields: [chaletId], references: [id], onDelete: Cascade)

  @@unique([chaletId, position])
  @@index([chaletId, createdAt])
  @@map("hosting_chalet_images")
}

model HostingChaletAvailability {
  id            String               @id @default(uuid())
  chaletId      String               @map("chale_id")
  referenceDate DateTime             @map("reference_date") @db.Date
  status        ChaleStatus  @default(AVAILABLE) @map("status")
  reservationId String?              @map("reservation_id")
  blockId       String?              @map("block_id")
  notes         String?              @map("notes") @db.Text
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  chalet        HostingChalet        @relation(fields: [chaletId], references: [id], onDelete: Cascade)
  reservation   HostingReservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  block         HostingChaletBlock?  @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@unique([chaletId, referenceDate])
  @@index([status, referenceDate])
  @@map("hosting_chalet_availability")
}

model HostingPricingRule {
  id            String                    @id @default(uuid())
  name          String                    @map("nome") @db.VarChar(255)
  ruleType      PriceRuleType             @map("tipo_regra")
  percentage    Decimal                   @map("percentual") @db.Decimal(5, 2)
  startDate     DateTime                  @map("data_inicio") @db.Date
  endDate       DateTime                  @map("data_fim") @db.Date
  appliesToAll  Boolean                   @default(false) @map("aplica_todos")
  isActive      Boolean                   @default(true) @map("ativo")
  createdById   String?                   @map("criado_por")
  updatedById   String?                   @map("atualizado_por")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  deletedAt     DateTime?                 @map("deleted_at")
  chalets       HostingPricingRuleChalet[]
  reservations  HostingReservation[]
  createdBy     User?                     @relation("HostingPricingRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                     @relation("HostingPricingRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  auditLogs     HostingAuditLog[]

  @@index([isActive, startDate, endDate], map: "idx_preco_regras_ativas")
  @@index([startDate, endDate], map: "idx_preco_regras_datas")
  @@index([deletedAt])
  @@map("hosting_pricing_rules")
}

model HostingPricingRuleChalet {
  id        String            @id @default(uuid())
  ruleId    String            @map("regra_id")
  chaletId  String            @unique @map("chale_id")
  createdAt DateTime          @default(now()) @map("created_at")
  rule      HostingPricingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  chalet    HostingChalet     @relation(fields: [chaletId], references: [id], onDelete: Cascade)

  @@unique([ruleId, chaletId])
  @@index([ruleId])
  @@map("hosting_pricing_rule_chalets")
}

model HostingCancellationPolicy {
  id                    String               @id @default(uuid())
  name                  String               @db.VarChar(255)
  freeCancellationDays  Int                  @default(14) @map("free_cancellation_days")
  partialPenaltyFromDay Int                  @default(7) @map("partial_penalty_from_day")
  partialPenaltyToDay   Int                  @default(13) @map("partial_penalty_to_day")
  partialPenaltyPercent Decimal              @default(20) @map("partial_penalty_percent") @db.Decimal(5, 2)
  fullPenaltyPercent    Decimal              @default(50) @map("full_penalty_percent") @db.Decimal(5, 2)
  termsVersion          String               @map("terms_version") @db.VarChar(50)
  termsContent          String               @map("terms_content") @db.Text
  isActive              Boolean              @default(true) @map("is_active")
  effectiveFrom         DateTime             @map("effective_from") @db.Date
  effectiveTo           DateTime?            @map("effective_to") @db.Date
  createdById           String?              @map("created_by")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  reservations          HostingReservation[]
  createdBy             User?                @relation("HostingCancellationPolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, effectiveFrom, effectiveTo])
  @@index([createdById])
  @@map("cancellation_policies")
}

model HostingKpi {
  id            String           @id @default(uuid())
  referenceDate DateTime         @map("reference_date") @db.Date
  metric        HospedagemKpiType @map("metric")
  value         Decimal          @map("value") @db.Decimal(15, 2)
  metadata      Json?
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([metric, referenceDate])
  @@index([metric, referenceDate])
  @@index([referenceDate], map: "idx_hospedagem_kpis_data")
  @@index([metric], map: "idx_hospedagem_kpis_tipo")
  @@map("hosting_kpis")
}

model HostingReservation {
  id                   String                   @id @default(uuid())
  code                 String                   @unique @map("codigo") @db.VarChar(20)
  chaletId             String                   @map("chale_id")
  userId               String?                  @map("user_id")
  pricingRuleId        String?                  @map("regra_preco_id")
  cancellationPolicyId String?                  @map("cancellation_policy_id")
  status               ReservationStatus @default(PENDING) @map("status")
  origin               HostingReservationOrigin @default(ONLINE) @map("origem")
  guestName            String                   @map("nome_hospede") @db.VarChar(255)
  guestEmail           String?                  @map("email_hospede") @db.VarChar(255)
  guestPhone           String?                  @map("telefone_hospede") @db.VarChar(30)
  checkInDate          DateTime                 @map("data_checkin") @db.Date
  checkOutDate         DateTime                 @map("data_checkout") @db.Date
  adults               Int                      @default(1) @map("adultos")
  children             Int                      @default(0) @map("criancas")
  baseAmount           Decimal                  @map("valor_base") @db.Decimal(12, 2)
  discountAmount       Decimal                  @default(0) @map("valor_desconto") @db.Decimal(12, 2)
  surchargeAmount      Decimal                  @default(0) @map("valor_acrescimo") @db.Decimal(12, 2)
  totalAmount          Decimal                  @map("valor_total") @db.Decimal(12, 2)
  paymentStatus        PaymentStatus            @default(PENDING) @map("status_pagamento")
  paymentMethod        String?                  @map("metodo_pagamento")
  paymentId            String?                  @map("payment_id")
  paidAt               DateTime?                @map("pago_em")
  checkedInAt          DateTime?                @map("checkin_realizado_em")
  checkedOutAt         DateTime?                @map("checkout_realizado_em")
  cancelledAt          DateTime?                @map("cancelado_em")
  noShowAt             DateTime?                @map("no_show_at")
  noShowFeeAmount      Decimal?                 @map("no_show_fee_amount") @db.Decimal(12, 2)
  noShowReason         String?                  @map("no_show_reason") @db.Text
  vehiclePlate         String?                  @map("vehicle_plate") @db.VarChar(20)
  vehicleModel         String?                  @map("vehicle_model") @db.VarChar(120)
  vehicleColor         String?                  @map("vehicle_color") @db.VarChar(60)
  vehicleType          String?                  @map("vehicle_type") @db.VarChar(60)
  extraBedRequested    Boolean                  @default(false) @map("extra_bed_requested")
  extraBedFee          Decimal                  @default(0) @map("extra_bed_fee") @db.Decimal(12, 2)
  negotiationNotes     String?                  @map("negotiation_notes") @db.Text
  contactChannel       HostingContactChannel?   @map("contact_channel")
  contactNotes         String?                  @map("contact_notes") @db.Text
  policiesAccepted     Boolean                  @default(false) @map("policies_accepted")
  policiesAcceptedAt   DateTime?                @map("policies_accepted_at")
  policyVersion        String?                  @map("policy_version") @db.VarChar(50)
  policyTerm           String?                  @map("policy_term") @db.Text
  cancellationReason   String?                  @map("motivo_cancelamento") @db.Text
  notes                String?                  @map("observacoes") @db.Text
  createdById          String?                  @map("criado_por")
  updatedById          String?                  @map("atualizado_por")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  deletedAt            DateTime?                @map("deleted_at")
  chalet               HostingChalet            @relation(fields: [chaletId], references: [id])
  user                 User?                    @relation("HostingReservationUser", fields: [userId], references: [id], onDelete: SetNull)
  pricingRule          HostingPricingRule?      @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  cancellationPolicy   HostingCancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)
  payment              Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy            User?                    @relation("HostingReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                    @relation("HostingReservationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  guests               HostingReservationGuest[]
  vouchers             HostingReservationVoucher[]
  reviews              HostingReservationReview[]
  notificationLogs     HostingNotificationLog[]
  availability         HostingChaletAvailability[]
  auditLogs            HostingAuditLog[]

  @@index([chaletId, checkInDate, checkOutDate])
  @@index([status, checkInDate])
  @@index([paymentStatus, checkInDate])
  @@index([userId], map: "idx_reservas_user_id")
  @@index([cancellationPolicyId])
  @@index([noShowAt])
  @@index([deletedAt])
  @@index([code], map: "idx_reservas_codigo")
  @@index([status], map: "idx_reservas_status")
  @@index([checkInDate], map: "idx_reservas_checkin_data")
  @@index([checkOutDate], map: "idx_reservas_checkout_date")
  @@index([createdAt], map: "idx_reservas_created_at")
  @@index([chaletId], map: "idx_reservas_chale_id")
  @@map("hosting_reservations")
}

model HostingChaletBlock {
  id          String        @id @default(uuid())
  chaletId    String        @map("chale_id")
  startDate   DateTime      @map("data_inicio") @db.Date
  endDate     DateTime      @map("data_fim") @db.Date
  reason      BlockReason?  @map("motivo")
  notes       String?       @map("observacoes") @db.Text
  isActive    Boolean       @default(true) @map("ativo")
  createdById String?       @map("criado_por")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  chalet      HostingChalet @relation(fields: [chaletId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("HostingChaletBlockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  availability HostingChaletAvailability[]

  @@index([chaletId, startDate, endDate], map: "idx_bloqueios_datas")
  @@index([chaletId], map: "idx_bloqueios_chale_id")
  @@index([isActive])
  @@map("hosting_chalet_blocks")
}

model HostingReservationVoucher {
  id                   String             @id @default(uuid())
  reservationId        String             @map("reservation_id")
  qrCode               String             @map("qr_code")
  arrivalInstructions  String?            @map("arrival_instructions") @db.Text
  complexContacts      String?            @map("complex_contacts") @db.Text
  generatedAt          DateTime           @default(now()) @map("generated_at")
  sentByEmail          Boolean            @default(false) @map("sent_by_email")
  reservation          HostingReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("hosting_reservation_vouchers")
}

model HostingReservationGuest {
  id            String             @id @default(uuid())
  reservationId String             @map("reservation_id")
  fullName      String             @map("full_name") @db.VarChar(255)
  email         String?            @db.VarChar(255)
  phone         String?            @db.VarChar(30)
  cpf           String?            @db.VarChar(14)
  rg            String?            @db.VarChar(20)
  birthDate     DateTime?          @map("birth_date") @db.Date
  isPrimary     Boolean            @default(false) @map("is_primary")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  reservation   HostingReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId], map: "idx_hospedes_reserva_id")
  @@index([cpf])
  @@map("reservation_guests")
}

model HostingNotificationLog {
  id            String                    @id @default(uuid())
  reservationId String?                   @map("reservation_id")
  userId        String?                   @map("user_id")
  channel       HostingNotificationChannel
  event         String
  recipient     String                    @db.VarChar(255)
  payload       Json?
  status        HostingNotificationStatus @default(PENDING)
  attempts      Int                       @default(0)
  lastAttemptAt DateTime?                 @map("last_attempt_at")
  sentAt        DateTime?                 @map("sent_at")
  nextRetryAt   DateTime?                 @map("next_retry_at")
  errorMessage  String?                   @map("error_message") @db.Text
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  reservation   HostingReservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  user          User?                     @relation("HostingNotificationLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([userId])
  @@index([status, nextRetryAt])
  @@index([channel, event, createdAt])
  @@map("hosting_notification_logs")
}

model HostingReservationReview {
  id            String             @id @default(uuid())
  reservationId String             @unique @map("reservation_id")
  chaletId      String             @map("chale_id")
  userId        String?            @map("user_id")
  rating        Int                @map("rating")
  comment       String?            @map("comment") @db.Text
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  reservation   HostingReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  chalet        HostingChalet      @relation(fields: [chaletId], references: [id], onDelete: Cascade)
  user          User?              @relation("HostingReservationReviewUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([chaletId], map: "idx_avaliacoes_chale_id")
  @@index([userId], map: "idx_avaliacoes_user_id")
  @@map("hosting_reservation_reviews")
}

model HostingAuditLog {
  id            String               @id @default(uuid())
  reservationId String?              @map("reserva_id")
  chaletId      String?              @map("chale_id")
  pricingRuleId String?              @map("regra_preco_id")
  userId        String?              @map("user_id")
  action        String               @map("acao")
  oldValue      Json?                @map("valor_anterior")
  newValue      Json?                @map("valor_novo")
  ipAddress     String?              @map("ip_address")
  userAgent     String?              @map("user_agent")
  createdAt     DateTime             @default(now()) @map("created_at")
  reservation   HostingReservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  chalet        HostingChalet?       @relation(fields: [chaletId], references: [id], onDelete: SetNull)
  pricingRule   HostingPricingRule?  @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  user          User?                @relation("HostingAuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([chaletId])
  @@index([pricingRuleId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("hosting_audit_logs")
}
