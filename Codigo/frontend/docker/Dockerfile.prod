FROM node:20-alpine AS auth-build

WORKDIR /app

ARG AUTH_VITE_API_BASE_URL=/api
ARG AUTH_VITE_BASE_PATH=/auth/
ARG AUTH_VITE_USER_APP_URL=/user/
ARG AUTH_VITE_ADMIN_APP_URL=/admin/

ENV VITE_API_BASE_URL=${AUTH_VITE_API_BASE_URL}
ENV VITE_BASE_PATH=${AUTH_VITE_BASE_PATH}
ENV VITE_USER_APP_URL=${AUTH_VITE_USER_APP_URL}
ENV VITE_ADMIN_APP_URL=${AUTH_VITE_ADMIN_APP_URL}

COPY auth/package*.json ./
RUN npm ci

COPY auth/ ./
RUN npm run build

FROM node:20-alpine AS user-build

WORKDIR /app

ARG USER_VITE_API_BASE_URL=/api
ARG USER_VITE_BASE_PATH=/user/
ARG USER_VITE_AUTH_APP_URL=/auth/
ARG USER_VITE_MERCADOPAGO_PUBLIC_KEY=
ARG USER_VITE_STORE_INSTAGRAM_URL=
ARG USER_VITE_STORE_WHATSAPP_PHONE=

ENV VITE_API_BASE_URL=${USER_VITE_API_BASE_URL}
ENV VITE_BASE_PATH=${USER_VITE_BASE_PATH}
ENV VITE_AUTH_APP_URL=${USER_VITE_AUTH_APP_URL}
ENV VITE_MERCADOPAGO_PUBLIC_KEY=${USER_VITE_MERCADOPAGO_PUBLIC_KEY}
ENV VITE_STORE_INSTAGRAM_URL=${USER_VITE_STORE_INSTAGRAM_URL}
ENV VITE_STORE_WHATSAPP_PHONE=${USER_VITE_STORE_WHATSAPP_PHONE}

COPY user/package*.json ./
RUN npm ci

COPY user/ ./
RUN npm run build

FROM node:20-alpine AS admin-build

WORKDIR /app

ARG ADMIN_VITE_API_BASE_URL=/api
ARG ADMIN_VITE_BASE_PATH=/admin/

ENV VITE_API_BASE_URL=${ADMIN_VITE_API_BASE_URL}
ENV VITE_BASE_PATH=${ADMIN_VITE_BASE_PATH}

COPY administrator/package*.json ./
RUN npm ci

COPY administrator/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY docker/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=auth-build /app/dist /usr/share/nginx/html/auth
COPY --from=user-build /app/dist /usr/share/nginx/html/user
COPY --from=admin-build /app/dist /usr/share/nginx/html/admin

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
